{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "raincheck",
  "main": "./api/forecast.ts",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "secrets": {
    "required": ["TOMORROW_IO_API_KEY"]
  }
}